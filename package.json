{
  "name": "omo-codex-computer",
  "version": "0.1.2",
  "description": "OMO Native plugin for OpenAI Codex Computer Use and first-party Chrome automation through Codex app-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastertyko/omo-codex-computer.git"
  },
  "bugs": {
    "url": "https://github.com/mastertyko/omo-codex-computer/issues"
  },
  "homepage": "https://github.com/mastertyko/omo-codex-computer#readme",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "skills",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "qa:host": "bun run scripts/qa-host.ts",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "bun run check && npm pack --dry-run"
  },
  "keywords": [
    "omo",
    "senpi",
    "pi-package",
    "codex",
    "computer-use",
    "chrome-automation"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@code-yeongyu/senpi": "2026.9.2-4",
    "typebox": "1.3.18"
  },
  "peerDependenciesMeta": {
    "@code-yeongyu/senpi": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@code-yeongyu/senpi": "2026.9.2-4",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "typebox": "1.3.18"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  }
}
